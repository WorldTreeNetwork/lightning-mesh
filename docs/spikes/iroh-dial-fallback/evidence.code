850:     fn handle_msg_resolve_remote(
851:         &mut self,
852:         addrs: BTreeSet<TransportAddr>,
853:         tx: oneshot::Sender<Result<(), AddressLookupFailed>>,
854:     ) {
855:         let addrs = to_transports_addr(self.endpoint_id, addrs);
856:         self.paths.insert_multiple(addrs, Source::App);
857:         self.paths.resolve_remote(tx);
858:         // Start Address Lookup if we have no selected path.
859:         self.trigger_address_lookup();
860:     }
