161:     pub(super) fn resolve_remote(&mut self, tx: oneshot::Sender<Result<(), AddressLookupFailed>>) {
162:         if !self.paths.is_empty() {
163:             tx.send(Ok(())).ok();
164:         } else {
165:             self.pending_resolve_requests.push_back(tx);
166:         }
167:     }
