## /home/dorje/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/iroh-1.0.0/src/socket/remote_map/remote_state.rs trigger_address_lookup
866:     fn trigger_address_lookup(&mut self) {
867:         if self.selected_path.is_some() || self.address_lookup_stream.is_some() {
868:             return;
869:         }
870:         let stream = self.address_lookup.resolve(self.endpoint_id);
871:         let stream = stream.filter_map(|item| match item {
872:             // We don't care about errors from individual services, we just continue.
873:             // Individual errors are buffered into the final error by `AddressLookupServices::resolve`,
874:             // and if the lookup fails we return them upstream with the final `AddressLookupFailed` error.
875:             Ok(Err(_err)) => None,
876:             Ok(Ok(item)) => Some(Ok(item)),
877:             Err(err) => Some(Err(err)),
878:         });
879:         self.address_lookup_stream = Some(Box::pin(stream));
880:     }
881: 
882:     /// Handles an address lookup result.
883:     ///
884:     /// All address lookup results end up being sent here. It takes care of updating the
885:     /// [`RemotePathState`] with the results.

