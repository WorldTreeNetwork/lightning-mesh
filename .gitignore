# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.spawns/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

**/*.trace
**/*.zip
**/*.tar.gz
**/*.tgz
**/*.log
package-lock.json
**/*.bun
.omc
.metacoding/
# Cargo: workspace root, crate-local, and CARGO_TARGET_DIR=target/sim-cross
/target/
**/target/
.omx
# Intention conductor packets/leases from local /act runs (like .spawns).
# Already-tracked files under groups/ stay in git; new runs stay local.
/groups/
# Editor / patch leftovers
*~
*.swp
*.swo
*.orig
*.rej
*.rs.bk

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# MikroTik container build artifacts
deploy/mikrotik/*.tar

# OpenWrt native build artifact (static aarch64 binary; rebuild with deploy/openwrt/build.sh)
deploy/openwrt/*-aarch64

# Sim lab artifacts (rebuild with deploy/sim/build-meshd.sh / build-image.sh)
deploy/sim/*-x86_64
deploy/sim/*.img
deploy/sim/*.img.gz
deploy/sim/imagebuilder/
deploy/sim/disks/
deploy/sim/bin/
*.qcow2
*.nvram
*.raw

# Prefetched OpenWrt packages (install-node.sh fills this from any node with
# feed access; pushed to nodes without WAN). Re-fetchable, release-specific.
deploy/openwrt/pkg-cache/

# Official MikroTik RouterOS packages (large binaries, MikroTik's to distribute).
# Re-download with deploy/mikrotik/fetch-firmware.sh.
deploy/mikrotik/*.npk

# meshctl per-router node secrets (IROH_SECRET) — never commit
deploy/mikrotik/secrets/

# OpenWrt fleet secrets (MESH_KEY/CLIENT_KEY/FT_KEY wireless env) — never
# commit; only the checked-in .example template survives this ignore.
deploy/openwrt/fleet-secrets/*
!deploy/openwrt/fleet-secrets/*.example
.playwright-mcp
